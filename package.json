{
  "name": "memoris",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Memoris — your second brain for working in a second language.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @memoris/server dev",
    "dev:extension": "pnpm --filter @memoris/extension dev",
    "dev:dashboard": "pnpm --filter @memoris/dashboard dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
