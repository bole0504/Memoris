# Server (gateway) configuration — copy to .env and fill in.

# Local SQLite for users/quota/billing (server-side; no DB server on the tiny VPS).
DATABASE_URL="file:./prisma/dev.db"

# HTTP
PORT=3000
HOST="0.0.0.0"

# CORS — comma-separated origins allowed to call the gateway (dashboard, extension dev).
# Use "*" only in local dev.
CORS_ORIGINS="*"

# --- LLM provider for chat/translate ---
# If set, chat routes through OpenRouter (one API, many models, fallback). If empty, uses Gemini.
# Key lives ONLY here, never in the client (docs/ARCHITECTURE.md §3).
OPENROUTER_API_KEY=""
# OpenRouter model ids, tried in order for fallback. See https://openrouter.ai/models
LLM_MODELS="openai/gpt-4o-mini"

# --- Gemini (used for embeddings always; and for chat when OPENROUTER_API_KEY is empty) ---
GEMINI_API_KEY=""
# Cheapest model with free-tier quota that works for us. Override to change tiers.
GEMINI_MODEL="gemini-2.5-flash-lite"
# Tried in order when the primary returns 429/503 (comma-separated).
GEMINI_FALLBACK_MODELS="gemini-2.0-flash"
# Embeddings model (free tier).
GEMINI_EMBED_MODEL="gemini-embedding-001"

# --- Auth ---
# JWT signing secret. Generate: openssl rand -hex 32
JWT_SECRET="dev-insecure-change-me"
# Access-token TTL (minutes) and refresh-token TTL (days).
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# --- Quota (Phase 5) ---
# Free plan: max Tier-2 (real AI) lookups per user per day.
FREE_DAILY_AI_LOOKUPS=50

# Restrict the dev login when the gateway is publicly exposed (comma-separated). Empty = allow any.
# DEV_LOGIN_ALLOWED_EMAILS="duc.le@opswat.com"

# --- Google OAuth (optional; falls back to dev email login if unset) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
