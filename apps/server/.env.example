# Server (gateway) configuration — copy to .env and fill in.

# Local SQLite for users/quota/billing (server-side; no DB server on the tiny VPS).
DATABASE_URL="file:./prisma/dev.db"

# HTTP
PORT=3000
HOST="0.0.0.0"

# CORS — comma-separated origins allowed to call the gateway (dashboard, extension dev).
# Use "*" only in local dev.
CORS_ORIGINS="*"

# --- Wired up in Phase 1 (left here so the shape is known) ---
# AI provider key — NEVER ships in the client; lives only on the gateway.
# ANTHROPIC_API_KEY=""
# Google OAuth (Phase 1 auth).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# JWT_SECRET=""
